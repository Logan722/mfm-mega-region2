[{"n":"Abraham","c":[["I was told to leave my country, my family and my father’s house.","Genesis 12:1-4","https://www.biblegateway.com/passage/?search=Genesis%2012%3A1-4&version=KJV"],["God changed my name when I was 99 years old.","Genesis 17:1-5","https://www.biblegateway.com/passage/?search=Genesis%2017%3A1-5&version=KJV"],["I was willing to offer my son on Mount Moriah.","Genesis 22:1-2","https://www.biblegateway.com/passage/?search=Genesis%2022%3A1-2&version=KJV"],["My wife Sarah laughed when she heard she would have a son.","Genesis 18:9-12","https://www.biblegateway.com/passage/?search=Genesis%2018%3A9-12&version=KJV"],["I am called the father of many nations.","Genesis 17:5","https://www.biblegateway.com/passage/?search=Genesis%2017%3A5&version=KJV"]]},{"n":"Moses","c":[["I was hidden for three months as a baby.","Exodus 2:2-10","https://www.biblegateway.com/passage/?search=Exodus%202%3A2-10&version=KJV"],["I fled to Midian and kept the flock of Jethro.","Exodus 3:1","https://www.biblegateway.com/passage/?search=Exodus%203%3A1&version=KJV"],["God spoke to me from a burning bush.","Exodus 3:2-4","https://www.biblegateway.com/passage/?search=Exodus%203%3A2-4&version=KJV"],["I stretched out my hand over the Red Sea.","Exodus 14:21","https://www.biblegateway.com/passage/?search=Exodus%2014%3A21&version=KJV"],["I brought the Ten Commandments down from Mount Sinai.","Exodus 34:29","https://www.biblegateway.com/passage/?search=Exodus%2034%3A29&version=KJV"]]},{"n":"David","c":[["I was the youngest son of Jesse.","1 Samuel 16:11-13","https://www.biblegateway.com/passage/?search=1%20Samuel%2016%3A11-13&version=KJV"],["I played the harp for King Saul.","1 Samuel 16:23","https://www.biblegateway.com/passage/?search=1%20Samuel%2016%3A23&version=KJV"],["My best friend was Jonathan.","1 Samuel 18:1-3","https://www.biblegateway.com/passage/?search=1%20Samuel%2018%3A1-3&version=KJV"],["I danced before the LORD with all my might.","2 Samuel 6:14","https://www.biblegateway.com/passage/?search=2%20Samuel%206%3A14&version=KJV"],["I defeated Goliath with a sling and a stone.","1 Samuel 17:49-50","https://www.biblegateway.com/passage/?search=1%20Samuel%2017%3A49-50&version=KJV"]]},{"n":"Joseph","c":[["I was sold to the Ishmeelites for twenty pieces of silver.","Genesis 37:28","https://www.biblegateway.com/passage/?search=Genesis%2037%3A28&version=KJV"],["I was put in prison in Egypt though I had done no wrong.","Genesis 39:20","https://www.biblegateway.com/passage/?search=Genesis%2039%3A20&version=KJV"],["I explained the dreams of the butler and the baker.","Genesis 40:8-22","https://www.biblegateway.com/passage/?search=Genesis%2040%3A8-22&version=KJV"],["Pharaoh made me ruler over all the land of Egypt.","Genesis 41:41-43","https://www.biblegateway.com/passage/?search=Genesis%2041%3A41-43&version=KJV"],["My father gave me a coat of many colours.","Genesis 37:3","https://www.biblegateway.com/passage/?search=Genesis%2037%3A3&version=KJV"]]},{"n":"Noah","c":[["My father was Lamech.","Genesis 5:28-29","https://www.biblegateway.com/passage/?search=Genesis%205%3A28-29&version=KJV"],["I had three sons: Shem, Ham and Japheth.","Genesis 6:10","https://www.biblegateway.com/passage/?search=Genesis%206%3A10&version=KJV"],["I sent out a raven and then a dove.","Genesis 8:6-8","https://www.biblegateway.com/passage/?search=Genesis%208%3A6-8&version=KJV"],["I found grace in the eyes of the LORD.","Genesis 6:8","https://www.biblegateway.com/passage/?search=Genesis%206%3A8&version=KJV"],["I built an ark before the flood.","Genesis 6:13-14","https://www.biblegateway.com/passage/?search=Genesis%206%3A13-14&version=KJV"]]},{"n":"Daniel","c":[["I would not defile myself with the king’s meat.","Daniel 1:8","https://www.biblegateway.com/passage/?search=Daniel%201%3A8&version=KJV"],["My Babylonian name was Belteshazzar.","Daniel 1:7","https://www.biblegateway.com/passage/?search=Daniel%201%3A7&version=KJV"],["I read the writing on the wall for King Belshazzar.","